              "keywords": [
                "共线",
                "正则",
                "稳定"
              ],
              "core_idea": "自变量高度共线、普通回归系数震荡时，L2 收缩稳定估计、降低方差。",
              "application": "高维共线数据回归、房价预测。"
            },
