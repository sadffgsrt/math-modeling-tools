{
  "name": "CUMCM-HMML",
  "version": "1.0",
  "description": "面向 CUMCM/国赛的层次化建模方法库（Hierarchical Modeling Method Library）。结构：领域(domain) → 子领域(subdomain) → 方法(method)。参考 MM-Agent 的 HMML 设计思路移植，方法节点映射到本平台 model_catalog.json 的 53 个已实现模型。离线可用，不依赖 LLM。",
  "domains": [
    {
      "domain": "评价与决策",
      "domain_en": "Evaluation & Decision",
      "keywords": [
        "评价",
        "排名",
        "排序",
        "优选",
        "权重",
        "决策",
        "综合",
        "打分"
      ],
      "subdomains": [
        {
          "subdomain": "综合评价",
          "methods": [
            {
              "method": "层次分析法(AHP)",
              "method_class": "evaluation",
              "model_id": "ahp",
              "description": "将复杂决策分解为层次结构，用成对比较矩阵求权重，适合多准则定性转定量评价。",
              "keywords": [
                "准则",
                "权重",
                "比较",
                "主观"
              ],
              "core_idea": "当决策含多个定性准则且需把主观经验量化成权重时，用成对比较矩阵把「重要性」转成可计算的相对权重。",
              "application": "供应商优选、方案排序、风险等级评估、设施选址打分。"
            },
            {
              "method": "TOPSIS 理想解法",
              "method_class": "evaluation",
              "model_id": "topsis",
              "description": "按与正/负理想解的贴近度对方案排序，适合多属性决策。",
              "keywords": [
                "方案",
                "距离",
                "贴近度",
                "排序"
              ],
              "core_idea": "有多方案与多维指标、需要「离最优最近、离最差最远」的直观排序时，贴近度比逐对比较更易解释。",
              "application": "产品综合排名、投资方案优选、城市宜居度评价。"
            },
            {
              "method": "熵权法",
              "method_class": "evaluation",
              "model_id": "entropy_weight",
              "description": "用指标变异程度客观赋权，减少主观偏差，常与其余方法组合。",
              "keywords": [
                "客观",
                "变异",
                "赋权",
                "信息熵"
              ],
              "core_idea": "希望赋权尽量客观、避免人为主观偏差时，用指标变异信息量定权——数据越离散权重越大。",
              "application": "与 AHP/TOPSIS 组合的客观赋权、绩效指标加权。"
            },
            {
              "method": "灰色关联分析",
              "method_class": "evaluation",
              "model_id": "grey_relational",
              "description": "按序列几何形状相似度评价因素关联度，适合小样本。",
              "keywords": [
                "关联度",
                "小样本",
                "相似"
              ],
              "core_idea": "样本极少、信息不完全（灰）时，用序列几何相似度代替分布假设做关联评价，不要求大样本。",
              "application": "小样本因素关联评价、农业/环境因子分析。"
            },
            {
              "method": "主成分/综合评法",
              "method_class": "evaluation",
              "model_id": "comprehensive_evaluation",
              "description": "降维提取主成分并加权综合，缓解指标共线。",
              "keywords": [
                "降维",
                "共线",
                "综合得分"
              ],
              "core_idea": "指标高度共线、需降维提炼主成分再综合时，避免多重共线性放大估计误差。",
              "application": "区域综合实力评价、教学质量/绩效评估。"
            }
          ]
        },
        {
          "subdomain": "模糊评价",
          "methods": [
            {
              "method": "模糊综合评价",
              "method_class": "evaluation",
              "model_id": "fuzzy_evaluation",
              "description": "用隶属度处理边界不清的定性评价，适合含模糊语义的准则。",
              "keywords": [
                "模糊",
                "隶属度",
                "语义"
              ],
              "core_idea": "准则含「较好/一般」等边界不清的模糊语义时，用隶属度把定性判断转定量更贴合人类认知。",
              "application": "服务质量评价、生态环境模糊评级。"
            }
          ]
        }
      ]
    },
