{
  "name": "CUMCM-HMML",
  "version": "1.0",
  "description": "面向 CUMCM/国赛的层次化建模方法库（Hierarchical Modeling Method Library）。结构：领域(domain) → 子领域(subdomain) → 方法(method)。参考 MM-Agent 的 HMML 设计思路移植，方法节点映射到本平台 model_catalog.json 的 53 个已实现模型。离线可用，不依赖 LLM。",
  "domains": [
    {
      "domain": "评价与决策",
      "domain_en": "Evaluation & Decision",
      "keywords": ["评价", "排名", "排序", "优选", "权重", "决策", "综合", "打分"],
      "subdomains": [
        {
          "subdomain": "综合评价",
          "methods": [
            {"method": "层次分析法(AHP)", "method_class": "evaluation", "model_id": "ahp", "description": "将复杂决策分解为层次结构，用成对比较矩阵求权重，适合多准则定性转定量评价。", "keywords": ["准则", "权重", "比较", "主观"]},
            {"method": "TOPSIS 理想解法", "method_class": "evaluation", "model_id": "topsis", "description": "按与正/负理想解的贴近度对方案排序，适合多属性决策。", "keywords": ["方案", "距离", "贴近度", "排序"]},
            {"method": "熵权法", "method_class": "evaluation", "model_id": "entropy_weight", "description": "用指标变异程度客观赋权，减少主观偏差，常与其余方法组合。", "keywords": ["客观", "变异", "赋权", "信息熵"]},
            {"method": "灰色关联分析", "method_class": "evaluation", "model_id": "grey_relational", "description": "按序列几何形状相似度评价因素关联度，适合小样本。", "keywords": ["关联度", "小样本", "相似"]},
            {"method": "主成分/综合评法", "method_class": "evaluation", "model_id": "comprehensive_evaluation", "description": "降维提取主成分并加权综合，缓解指标共线。", "keywords": ["降维", "共线", "综合得分"]}
          ]
        },
        {
          "subdomain": "模糊评价",
          "methods": [
            {"method": "模糊综合评价", "method_class": "evaluation", "model_id": "fuzzy_evaluation", "description": "用隶属度处理边界不清的定性评价，适合含模糊语义的准则。", "keywords": ["模糊", "隶属度", "语义"]}
          ]
        }
      ]
    },
    {
