            {"method": "岭回归(Ridge)", "method_class": "regression", "model_id": "ridge", "description": "L2 正则缓解多重共线，提升预测稳定性。", "keywords": ["共线", "正则", "稳定"]},
            {"method": "Lasso 回归", "method_class": "regression", "model_id": "lasso", "description": "L1 正则兼具变量选择，自动筛特征。", "keywords": ["特征选择", "稀疏"]},
